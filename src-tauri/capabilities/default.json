{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/backend-app-exec",
          "sidecar": true,
          "args": [
            {
              "validator": "^[^-].*[/\\\\]java[/\\\\]?$"
            }
          ]
        },
        {
          "name": "binaries/mcp-app-exec",
          "sidecar": true,
          "args": [
            {
              "validator": "^[^-].*[/\\\\]mcp[/\\\\]?$"
            }
          ]
        }
      ]
    }
  ]
}
